# ── Backend ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Auth (JWT) — read by backend/api/auth.py
# CHANGE ME — the placeholder below is NOT secret. Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# docker compose refuses to start if AUTH_SECRET_KEY is unset or empty.
AUTH_SECRET_KEY=change-me-generate-a-real-secret
# Demo analyst account (defaults: analyst / nyayasetu2026) — CHANGE ME for any shared deployment
# AUTH_USERNAME=analyst
# AUTH_PASSWORD=
# Access-token lifetime in minutes
AUTH_TOKEN_TTL_MINUTES=60

# Real-LLM backend for the chatbot/agent (Anthropic preferred; deterministic fallback otherwise)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CHATBOT_MODEL=

# ── Frontend (frontend/.env.local) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

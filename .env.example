# ── Backend ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Runtime environment: "development" (default) or "production".
# production refuses to start unless AUTH_SECRET_KEY is a strong (>=32 char)
# non-placeholder secret. docker-compose.yml forces APP_ENV=production.
APP_ENV=development

# Auth (JWT) — read by backend/api/auth.py
# CHANGE ME — intentionally empty. Generate a real key and paste it here:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# docker compose refuses to start while AUTH_SECRET_KEY is empty; local dev
# without Docker falls back to an insecure dev secret (with a warning).
AUTH_SECRET_KEY=
# Demo analyst account (defaults: analyst / nyayasetu2026) — CHANGE ME for any shared deployment
# AUTH_USERNAME=analyst
# AUTH_PASSWORD=
# Access-token lifetime in minutes
AUTH_TOKEN_TTL_MINUTES=60

# Real-LLM backend for the chatbot/agent (Anthropic preferred; deterministic fallback otherwise)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CHATBOT_MODEL=

# ── Frontend (frontend/.env.local) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
